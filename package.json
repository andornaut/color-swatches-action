{
  "name": "color-swatches",
  "version": "1.0.3",
  "private": true,
  "description": "Generate 16x16 color swatch images from hex colors in files",
  "bin": {
    "color-swatches": "./color-swatches.mjs"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "prepare": "husky",
    "lint": "make lint",
    "format": "make exec COMMAND='npm run format:internal'",
    "lint:internal": "prettier --check . && eslint --max-warnings 0 .",
    "format:internal": "prettier --write . && eslint --fix .",
    "check": "make check",
    "test": "make test",
    "build": "make build"
  },
  "//": "WORKAROUND: https://github.com/advisories/GHSA-g3hv-75wg-m249. Remove when upstream dependency ranges require patched minimatch versions.",
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "11.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  }
}
